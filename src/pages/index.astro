---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import SectionTitle from "../components/SectionTitle.astro";
import InfoTable from "../components/InfoTable.astro";
import CircleCards from "../components/CircleCards.astro";
import HomeAccess from "../components/HomeAccess.astro";
import { homeExamples } from "../data/home-examples";
import { event } from "../config/event";
import { externalUrl, localImage, mailLink } from "../utils/content";
import circles from "../data/circles.json";
// These two subsets cover the kana and the kanji in the homepage headline.
import headlineKana from "@fontsource-variable/noto-serif-jp/files/noto-serif-jp-119-wght-normal.woff2?url";
import headlineKanji from "@fontsource-variable/noto-serif-jp/files/noto-serif-jp-79-wght-normal.woff2?url";
import "../styles/home.css";
import "../styles/poster.css";

const mainImage = localImage(event.images.main);
const date = event.date ?? event.dateEstimate;
const plannedDate = event.date ? null : /^(.+?)(開催予定)$/.exec(date);
const email = mailLink(event.contact.email);
const x = externalUrl(event.contact.xUrl);
---

<Layout title={`${event.homeTitle} -${event.homeSubtitle}-`}>
  <Fragment slot="font-preloads">
    {[headlineKana, headlineKanji].map((href) => (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        {href}
        crossorigin="anonymous"
      />
    ))}
  </Fragment>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-frame" aria-hidden="true"></div>
    <div class="hero-heading">
      <p class="hero-kicker">
        <Icon name="flower" size={18} />
        {event.subtitle}
      </p>
      <h1 id="hero-title">{event.homeTitle}</h1>
      <p class="hero-subtitle" lang="en">
        -{event.homeSubtitle}-
      </p>
    </div>
    {mainImage && (
      <div class="hero-art">
        <img
          src={mainImage}
          alt={event.images.alt}
          width={event.images.mainSize?.width}
          height={event.images.mainSize?.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}
    <div class="hero-details">
      <p class="hero-date">
        <span class="hero-date-main">{plannedDate?.[1] ?? date}</span>
        {plannedDate && <span class="hero-date-status">{plannedDate[2]}</span>}
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/general/">
          チケットのご案内 <Icon name="arrow" size={16} />
        </a>
        <a class="button secondary" href="/circle/">
          サークル申込 <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="about-section" id="about" aria-labelledby="about-title">
    <div class="wrap about-book">
      <div class="about-intro">
        <SectionTitle title="開催概要" id="about-title" />
        <p>{event.description}</p>
        {event.schedule.length > 0 && (
          <div class="about-links">
            <a class="text-link" href="/schedule/">
              当日のスケジュール
            </a>
          </div>
        )}
      </div>
      <div class="about-facts">
        <InfoTable
          rows={[
            ["開催日", event.date ?? event.dateEstimate],
            ["開催時間", event.hours ?? "調整中"],
            ["会場", event.venue.name ?? "未定"],
            ["主催", event.organizer ?? "未定"],
          ]}
        />
      </div>
    </div>
  </section>

  <div class="wrap home-details">
    <section id="circles" aria-labelledby="home-circles-heading">
      <SectionTitle title="参加サークル" id="home-circles-heading" />
      <CircleCards
        circles={circles.length ? circles.slice(0, 4) : homeExamples.circles}
        heading="h3"
        showPendingBooth={false}
      />
      {circles.length > 0 && (
        <a class="text-link home-details-link" href="/circles/">
          参加サークル一覧 <Icon name="arrow" size={16} />
        </a>
      )}
    </section>
    <HomeAccess />
    {(x || email) && (
      <section id="contact" aria-labelledby="home-contact-heading">
        <SectionTitle title="お問い合わせ" id="home-contact-heading" />
        <div class="home-contact-links">
          {x && (
            <a
              class="contact-icon"
              href={x}
              aria-label="Xで問い合わせる"
              title="Xで問い合わせる"
            >
              <Icon name="x" size={22} />
            </a>
          )}
          {email && (
            <a
              class="contact-icon"
              href={email}
              aria-label="メールで問い合わせる"
              title="メールで問い合わせる"
            >
              <Icon name="letter" size={24} />
            </a>
          )}
        </div>
      </section>
    )}
  </div>
</Layout>
