---
import Interior from "../layouts/Interior.astro";
import FaqList from "../components/FaqList.astro";
import { eventFaq, ticketFaq } from "../data/faq";
---

<Interior
  title="よくある質問"
  description="開催情報や参加方法、チケットに関するよくある質問をまとめています。"
>
  <section>
    <h2 class="subheading">開催・参加について</h2>
    <FaqList items={eventFaq} />
  </section>
  <section>
    <h2 class="subheading">チケットについて</h2>
    <FaqList items={ticketFaq} />
  </section>
  <a class="text-link" href="/contact/">
    お問い合わせ窓口へ →
  </a>
</Interior>
