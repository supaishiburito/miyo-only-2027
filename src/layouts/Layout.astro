---
import "@fontsource/instrument-serif/latin-400.css";
import displayFontUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import "@fontsource-variable/noto-serif-jp";
import "../styles/global.css";
import Header from "../components/Header.astro";
import SiteIntro from "../components/SiteIntro.astro";
import Footer from "../components/Footer.astro";
import { event } from "../config/event";
import { localImage } from "../utils/content";
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = event.description, noindex = false } = Astro.props;
const pageTitle = `${title} | ${event.name}`;
const canonical =
  Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const image = localImage(event.images.main);
const shareImage = canonical && image ? new URL(image, canonical) : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf8f0" />
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href={displayFontUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <slot name="font-preloads" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical.href} />}
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={event.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {shareImage && <meta property="og:image" content={shareImage.href} />}
    {shareImage && <meta property="og:image:alt" content={event.images.alt} />}
    <meta
      name="twitter:card"
      content={shareImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage.href} />}
    {shareImage && <meta name="twitter:image:alt" content={event.images.alt} />}
    <script is:inline>
      (() => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
          return;
        try {
          const key = "miyo:intro-seen";
          if (sessionStorage.getItem(key)) return;
          sessionStorage.setItem(key, "1");
          document.documentElement.dataset.siteIntro = "";
        } catch {
          // Continue without the intro when storage is unavailable.
        }
      })();
    </script>
  </head>
  <body id="top">
    <SiteIntro />
    <a href="#main" class="skip">
      本文へ移動
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
